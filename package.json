{
  "name": "jsqlite2",
  "private": true,
  "version": "0.0.0-stage3-first-select",
  "type": "module",
  "description": "Private Stage 3 source-translated foundation with bounded prepared SELECT execution, including documented multi-source joins; broader SQL remains unsupported.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate:parser": "node tools/parser/generate.mjs",
    "check:parser": "node --test test/parser/generator.test.mjs",
    "test:parser": "node --experimental-strip-types --test test/parser/tokenizer-parser.test.mjs test/parser/generator.test.mjs",
    "test:oracle": "python3 test/oracle/protocol.test.py && python3 test/oracle/jsonl.test.py && python3 test/oracle/schema-identifier-case.test.py",
    "fixtures:generate": "python3 tools/oracle/generate-fixtures.py --manifest reference/sqlite/manifest.json --profile $SAIVAGE_CARD_WORK_ROOT/oracle-build/profile.json --oracle $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/sqlite-oracle --spec-dir test/fixtures/spec --fixture-root test/fixtures",
    "test:fixtures": "python3 test/oracle/generate-fixtures.test.py && python3 test/oracle/storage-fixtures.test.py && node test/conformance/fixture-server.test.mjs",
    "test:conformance:native": "python3 test/conformance/runner.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so && python3 test/conformance/mem-native-boundaries.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so && python3 test/conformance/comparison-key-native-boundaries.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so && python3 test/conformance/run-first-select-native.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so",
    "test:conformance:ts": "node --experimental-strip-types test/conformance/run-first-select-ts.mjs",
    "test:package-boundary": "python3 test/package-boundary.test.py",
    "test:conformance:accounting": "python3 test/conformance/generate-ts-cases.py --check && node test/conformance/ts-accounting.test.mjs && python3 test/conformance/mem-manifest.test.py && python3 test/conformance/comparison-key-manifest.test.py && python3 test/conformance/first-select-manifest.test.py",
    "test:conformance:compound:manifest": "python3 test/conformance/compound-values-manifest.test.py && python3 test/conformance/compound-values-boundaries.test.py",
    "test:conformance:compound:native": "python3 test/conformance/recapture-compound-values.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so && python3 test/conformance/recapture-compound-values-boundaries.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so",
    "test:conformance:compound:ts": "node --experimental-strip-types test/conformance/run-compound-values-ts.mjs",
    "test:conformance:compound:unsupported": "node --experimental-strip-types --test test/conformance/compound-values-unsupported.test.mjs",
    "test:conformance:expressions:manifest": "python3 test/conformance/expression-functions-manifest.test.py",
    "test:conformance:expressions:native": "python3 test/conformance/capture-expression-functions.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so > $SAIVAGE_CARD_WORK_ROOT/expression-evidence/recaptured.json && cmp test/conformance/cases/stage3-expression-functions.json $SAIVAGE_CARD_WORK_ROOT/expression-evidence/recaptured.json",
    "test:conformance:expressions:ts": "node --experimental-strip-types test/conformance/run-expression-functions-ts.mjs",
    "test:conformance:expressions:companions": "node --experimental-strip-types test/conformance/run-expression-function-companions-ts.mjs",
    "test:conformance:expressions:boundaries": "python3 test/conformance/expression-function-boundaries.test.py",
    "test:conformance:expressions:cleanup-gap": "node test/conformance/run-expression-function-cleanup-ts.mjs",
    "test:conformance:expressions:opcodes": "node --experimental-strip-types test/conformance/run-expression-opcodes-ts.mjs",
    "test:conformance:expressions:cross-encoding": "node --experimental-strip-types test/conformance/run-expression-cross-encoding-ts.mjs",
    "test:conformance:expressions:bounded": "node --experimental-strip-types test/conformance/run-expression-bounded-ts.mjs",
    "test:conformance:multisource:manifest": "python3 test/conformance/multisource-select-manifest.test.py",
    "test:conformance:multisource:native": "python3 test/conformance/capture-multisource-select.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so --spec test/conformance/cases/stage3-multisource-select.spec.json --output $SAIVAGE_CARD_WORK_ROOT/multisource-recapture.json && cmp test/conformance/cases/stage3-multisource-select.json $SAIVAGE_CARD_WORK_ROOT/multisource-recapture.json",
    "test:conformance:aggregate:manifest": "python3 test/conformance/aggregate-group-manifest.test.py",
    "test:conformance:aggregate:native": "python3 test/conformance/capture-aggregate-group.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so --spec test/conformance/cases/stage3-aggregate-group.spec.json --fixture-root test/fixtures --output $SAIVAGE_CARD_WORK_ROOT/aggregate-recapture.json && cmp test/conformance/cases/stage3-aggregate-group.json $SAIVAGE_CARD_WORK_ROOT/aggregate-recapture.json && python3 test/conformance/aggregate-sum-native.py $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so",
    "test:conformance:aggregate:ts": "node --experimental-strip-types --test test/conformance/run-aggregate-group-ts.mjs test/conformance/aggregate-sum-context.test.mjs test/conformance/aggregate-context-opcodes.test.mjs",
    "test:conformance:subquery-view:manifest": "python3 test/conformance/subquery-view-manifest.test.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so",
    "test:conformance:subquery-view:ts": "node --experimental-strip-types --test test/conformance/subquery-view-foundation.test.mjs test/conformance/from-subquery-routes.test.mjs",
    "test:conformance:window": "python3 test/conformance/window-manifest.test.py",
    "test:conformance:window:native": "python3 test/conformance/capture-window.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so --spec test/conformance/cases/stage3-window.spec.json --output $SAIVAGE_CARD_WORK_ROOT/window-recapture.json && cmp test/conformance/cases/stage3-window.json $SAIVAGE_CARD_WORK_ROOT/window-recapture.json",
    "test:conformance:special-window": "python3 test/conformance/special-window-contract-manifest.test.py",
    "test:conformance:special-window:native": "python3 test/conformance/capture-special-window.py --library $SAIVAGE_CARD_WORK_ROOT/oracle-build/build/libsqlite3-oracle.so --spec test/conformance/cases/stage3-special-window.spec.json --output $SAIVAGE_CARD_WORK_ROOT/special-window-recapture.json && cmp test/conformance/cases/stage3-special-window.json $SAIVAGE_CARD_WORK_ROOT/special-window-recapture.json",
    "test:conformance:cte:manifest": "python3 test/conformance/cte-architecture-manifest.test.py"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
