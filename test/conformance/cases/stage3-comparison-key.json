      "operation": "compareRecordKey",
      "recordHex": "0209",
      "expectedError": "corrupt",
      "expectedEqSeen": false,
      "runtimeTest": "equal-prefix packed LHS field shortage is corrupt while short seek RHS reaches defaultRc",
      "nativeObservation": "native-record-short-packed-lhs-corrupt",
      "rationale": "packed LHS exhaustion is corrupt when another unpacked RHS field remains; prefix intent belongs to the RHS field count",
      "disposition": "local-safety-no-credit"
    },
    {
      "id": "record-declared-serial-truncated-payload",
      "operation": "compareRecordKey",
      "recordHex": "030901",
      "expectedError": "corrupt",
      "rationale": "deliberately stricter untrusted-input validation; pinned comparator assumes readable padded/valid b-tree key buffers and does not diagnose this synthetic payload truncation",
      "disposition": "local-safety-no-credit",
      "expectedEqSeen": false,
      "runtimeTest": "equal-prefix packed LHS field shortage is corrupt while short seek RHS reaches defaultRc"
