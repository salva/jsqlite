  "adaptations": [
    {
      "id": "clock-stable-across-rows-aliases-yields",
      "credit": false,
      "currentDisposition": "expected-temporary-unsupported",
      "sql": [
        "SELECT datetime('now'), current_timestamp, time('now'), current_time FROM users ORDER BY id"
      ],
      "setup": {
        "clockUnixMilliseconds": [
          "946684800125",
          "978307200250"
        ],
        "forcedYieldAfterRows": 1
      },
      "sequence": [
        "prepare: clock calls=0",
        "step all rows with one forced yield",
        "finalize"
      ],
      "expected": {
        "clockCalls": 1,
        "rows": "every row repeats TEXT 2000-01-01 00:00:00, TEXT 2000-01-01 00:00:00, TEXT 00:00:00, TEXT 00:00:00"
      }
    },
    {
      "id": "clock-resamples-after-reset",
      "credit": false,
      "currentDisposition": "expected-temporary-unsupported",
      "sql": [
        "SELECT unixepoch('now','subsec'), datetime('now','subsec')"
      ],
      "setup": {
        "clockUnixMilliseconds": [
          "946684800125",
          "978307200250"
        ]
      },
      "sequence": [
        "prepare: clock calls=0",
        "execute to done",
        "reset",
        "execute to done"
      ],
      "expected": {
        "clockCallsAfterExecutions": [
          1,
          2
        ],
        "rowsByExecution": [
          [
            {
              "type": "real",
              "value": "0x1.c36a1c0100000p+29"
            },
            {
              "type": "text",
              "value": "2000-01-01 00:00:00.125"
            }
          ],
          [
            {
              "type": "real",
              "value": "0x1.d27e440200000p+29"
            },
            {
              "type": "text",
              "value": "2001-01-01 00:00:00.250"
            }
          ]
        ]
      }
    },
