  "setup": [
    "PRAGMA page_size=512",
    "CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT COLLATE NOCASE, c REAL, payload TEXT, tag TEXT UNIQUE)",
    "CREATE INDEX ix_ab_desc ON t(a, b COLLATE NOCASE DESC)",
    "CREATE INDEX ix_c ON t(c)",
    "INSERT INTO t VALUES(1,1,'Alpha',1.0,'p1','tag1'),(2,1,'beta',2.5,'p2','tag2'),(3,1,NULL,3.0,'p3','tag3'),(4,2,'ALPHA',4.5,'p4','tag4'),(5,2,'gamma',5.0,'p5','tag5'),(6,3,'delta',6.25,'p6','tag6'),(7,NULL,'zeta',7.0,'p7','tag7')",
    "CREATE TABLE up_t1(a, b, c, d, e, PRIMARY KEY(a), UNIQUE(b COLLATE nocase DESC))",
    "CREATE INDEX up_t1c ON up_t1('c')",
    "CREATE INDEX up_t1d ON up_t1('d' COLLATE binary ASC)",
    "WITH RECURSIVE seq(x) AS (VALUES(1) UNION SELECT x+1 FROM seq WHERE x<30) INSERT INTO up_t1(a,b,c,d,e) SELECT x, printf('ab%03xxy',x), x, x, x FROM seq",
    "CREATE TABLE u(k INTEGER PRIMARY KEY, note TEXT)",
    "INSERT INTO u VALUES(1,'u1'),(8,'u8')"
  ],
