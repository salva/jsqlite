  "setup": [
    "PRAGMA page_size=512",
    "CREATE TABLE wr(a TEXT COLLATE NOCASE,b INTEGER,c REAL,payload TEXT,PRIMARY KEY(a,b)) WITHOUT ROWID",
    "CREATE INDEX wr_c ON wr(c)",
    "INSERT INTO wr VALUES('Alpha',1,1.0,'w1'),('alpha',2,2.5,'w2'),('beta',1,3.0,'w3'),('gamma',2,5.0,'w4')",
    "CREATE TABLE p(id INTEGER PRIMARY KEY,a INTEGER,b TEXT,c REAL)",
    "CREATE INDEX p_live ON p(a,b) WHERE c IS NOT NULL",
    "INSERT INTO p VALUES(1,1,'x',1.0),(2,1,'y',NULL),(3,2,'z',2.5),(4,3,'q',3.0)",
    "CREATE TABLE e(id INTEGER PRIMARY KEY,a TEXT,b INTEGER)",
    "CREATE INDEX e_expr ON e(lower(a),b+1)",
    "INSERT INTO e VALUES(1,'Alpha',4),(2,'BETA',5),(3,'alpha',6)",
    "CREATE TABLE m(id INTEGER PRIMARY KEY,a INTEGER,b INTEGER,c INTEGER)",
    "CREATE INDEX m_abc ON m(a,b,c)",
    "INSERT INTO m VALUES(1,1,1,1),(2,1,2,2),(3,1,3,3),(4,2,2,4),(5,3,3,5)",
    "CREATE TABLE ov(id INTEGER PRIMARY KEY,k TEXT,payload TEXT)",
    "CREATE INDEX ov_k_payload ON ov(k,payload)",
    "INSERT INTO ov VALUES(1,'needle',printf('%01200d',1)),(2,'other','small')"
  ],
  "cases": [
    {
      "id": "wr-primary-exact",
      "sql": "SELECT a,b,typeof(c),c,payload FROM wr WHERE a=?1 AND b=?2",
      "bindings": [
        "ALPHA",
        2
      ],
      "requiresPlan": "PRIMARY KEY"
    },
    {
      "id": "wr-primary-prefix",
      "sql": "SELECT a,b,payload FROM wr WHERE a=?1 ORDER BY b",
      "bindings": [
        "alpha"
      ],
      "requiresPlan": "PRIMARY KEY"
    },
    {
      "id": "wr-secondary-suffix",
      "sql": "SELECT a,b,typeof(c),c FROM wr WHERE c>=?1 ORDER BY c,a,b",
      "bindings": [
        2.5
      ],
      "requiresPlan": "wr_c"
    },
    {
      "id": "partial-implied",
      "sql": "SELECT id,b FROM p WHERE a=?1 AND c IS NOT NULL ORDER BY b",
      "bindings": [
        1
      ],
      "requiresPlan": "p_live"
    },
    {
      "id": "partial-not-implied",
      "sql": "SELECT id,b FROM p WHERE a=?1 ORDER BY b",
      "bindings": [
        1
      ],
      "forbidsPlan": "p_live"
    },
    {
      "id": "expression-identical",
      "sql": "SELECT id,a,b FROM e WHERE lower(a)=?1 AND b+1=?2 ORDER BY id",
      "bindings": [
        "alpha",
        5
      ],
      "requiresPlan": "e_expr"
    },
    {
      "id": "expression-mismatch",
      "sql": "SELECT id,a FROM e WHERE upper(a)=?1 AND b+1=?2 ORDER BY id",
      "bindings": [
        "ALPHA",
        5
      ],
      "forbidsPlan": "e_expr"
    },
    {
      "id": "index-backed-in",
      "sql": "SELECT id,a,b FROM m WHERE a IN (?1,?2) ORDER BY a,b,id",
      "bindings": [
        1,
        3
      ],
      "requiresPlan": "m_abc"
    },
    {
      "id": "composite-equality-two-ranges",
      "sql": "SELECT id,a,b,c FROM m WHERE a=?1 AND b>=?2 AND b<=?3 AND c>?4 ORDER BY b,c",
      "bindings": [
        1,
        1,
        3,
        1
      ],
      "requiresPlan": "m_abc"
    },
    {
      "id": "multiple-range-neighbor",
      "sql": "SELECT id,a,b,c FROM m WHERE a>=?1 AND b>=?2 ORDER BY a,b,c",
      "bindings": [
        1,
        2
      ],
      "requiresPlan": "m_abc"
    }
  ],
