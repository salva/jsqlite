    "CREATE TABLE wr_map(a TEXT COLLATE NOCASE,b INTEGER,c REAL,payload TEXT,PRIMARY KEY(a DESC,b DESC)) WITHOUT ROWID",
    "CREATE INDEX wr_map_mixed ON wr_map(a,c)",
    "CREATE INDEX wr_map_reordered ON wr_map(b,c)",
    "CREATE INDEX wr_map_all ON wr_map(b,c,a)",
    "CREATE INDEX wr_map_collation ON wr_map(a COLLATE BINARY,c)",
    "INSERT INTO wr_map VALUES('Alpha',1,NULL,'m-null'),('alpha',2,2.5,'m-target'),('beta',1,3.0,'m-beta'),('gamma',2,5.0,'m-gamma')",
    "CREATE TABLE p(id INTEGER PRIMARY KEY,a INTEGER,b TEXT,c REAL)",
    "CREATE INDEX p_live ON p(a,b) WHERE c IS NOT NULL",
    "INSERT INTO p VALUES(1,1,'x',1.0),(2,1,'y',NULL),(3,2,'z',2.5),(4,3,'q',3.0)",
    "CREATE TABLE e(id INTEGER PRIMARY KEY,a TEXT,b INTEGER)",
    "CREATE INDEX e_expr ON e(lower(a),b+1)",
    "INSERT INTO e VALUES(1,'Alpha',4),(2,'BETA',5),(3,'alpha',6)",
    "CREATE TABLE m(id INTEGER PRIMARY KEY,a INTEGER,b INTEGER,c INTEGER)",
    "CREATE INDEX m_abc ON m(a,b,c)",
    "INSERT INTO m VALUES(1,1,1,1),(2,1,2,2),(3,1,3,3),(4,2,2,4),(5,3,3,5)",
