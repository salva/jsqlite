    "reference/sqlite/sqlite-src-3530400/test/with2.test":"9f83b8c7668058563745ce02b957b87f914437e169400b1bd94c81d551eb7427"
  },
  "cases":[
    {
      "id":"with2-1.14",
      "credit":"upstream",
      "source":"test/with2.test",
      "assertion":"1.14",
      "setup":[],
      "sql":"WITH t4(x) AS (VALUES(4) UNION ALL SELECT x+1 FROM t4 WHERE x<10) SELECT * FROM t4;",
      "expect":{
        "rows":[
          [
            4
          ],
          [
            5
          ],
          [
            6
          ],
          [
            7
          ],
          [
            8
          ],
          [
            9
          ],
          [
            10
          ]
        ]
      }
    },
    {
      "id":"with1-5.6.1",
      "credit":"upstream",
      "source":"test/with1.test",
      "assertion":"5.6.1",
      "setup":[],
      "sql":"WITH i(x,y) AS (VALUES(1)) SELECT * FROM i;",
      "expect":{
        "error":{
          "phase":"prepare",
          "message":"table i has 1 values for 2 columns"
        }
      }
    },
    {
      "id":"with1-7.5",
      "credit":"upstream",
      "source":"test/with1.test",
      "assertion":"7.5",
      "setup":[
        "CREATE TABLE tree(i,p)",
        "INSERT INTO tree VALUES(2,NULL),(4,2),(5,4)"
      ],
      "sql":"WITH t(id) AS (VALUES(2) UNION ALL SELECT i FROM tree,t WHERE p=id AND p IN (SELECT id FROM t)) SELECT id FROM t;",
      "expect":{
        "error":{
          "phase":"prepare",
          "message":"multiple recursive references: t"
        }
      }
    },
    {
      "id":"with1-16.1",
      "credit":"upstream",
      "source":"test/with1.test",
      "assertion":"16.1",
      "setup":[],
      "sql":"WITH RECURSIVE i(x) AS (VALUES(1) UNION SELECT count(*) FROM i) SELECT * FROM i;",
      "expect":{
        "error":{
          "phase":"prepare",
          "message":"recursive aggregate queries not supported"
        }
      }
    },
    {
      "id":"with1-16.2",
      "credit":"upstream",
      "source":"test/with1.test",
      "assertion":"16.2",
      "setup":[],
      "sql":"WITH RECURSIVE i(x) AS (VALUES(1) UNION SELECT count(*) OVER () FROM i) SELECT * FROM i;",
      "expect":{
        "error":{
          "phase":"prepare",
          "message":"cannot use window functions in recursive queries"
        }
      }
    },
    {
      "id":"companion-recursive-limit-offset",
      "credit":"none",
      "rationale":"Isolates queue LIMIT/OFFSET termination without outer LIMIT.",
      "setup":[],
      "sql":"WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c LIMIT 3 OFFSET 2) SELECT x FROM c;",
      "expect":{
        "rows":[
          [
            3
          ],
          [
            4
          ],
          [
            5
          ]
        ]
      }
    },
    {
      "id":"companion-multi-owner-collation",
      "credit":"none",
      "rationale":"Distinguishes explicit NOCASE, direction, and NULL placement in the bounded multi-recursive-owner output sorter.",
      "setup":[],
      "sql":"WITH RECURSIVE a(x) AS (VALUES('a') UNION ALL SELECT 'B' FROM a WHERE x='a'), b(y) AS (VALUES(NULL) UNION ALL SELECT 'z' FROM b WHERE y IS NULL) SELECT x,y FROM a,b ORDER BY x COLLATE NOCASE ASC, y COLLATE NOCASE DESC NULLS FIRST;",
      "expect":{
        "rows":[
          [
            "a",
            null
          ],
          [
            "a",
            "z"
          ],
          [
            "B",
            null
          ],
          [
            "B",
            "z"
          ]
        ]
      }
    }
  ]
